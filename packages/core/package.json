{
  "name": "@interop-gateway/core",
  "version": "1.0.0",
  "description": "Core conversion functionality for interop-gateway: HL7v2/CDA ↔ FHIR translation, US Core profile validation, and shared primitives (correlation IDs, audit log, encrypted storage, secrets-provider interface, scope enforcement, TLS enforcement).",
  "keywords": [
    "fhir",
    "smart-on-fhir",
    "hl7",
    "hl7v2",
    "cda",
    "us-core",
    "healthcare",
    "healthtech",
    "interoperability",
    "hipaa"
  ],
  "license": "Apache-2.0",
  "author": "Kundan",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyitskundan/interop-gateway.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/heyitskundan/interop-gateway#readme",
  "bugs": {
    "url": "https://github.com/heyitskundan/interop-gateway/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": {
        "import": "./dist/node.d.ts",
        "require": "./dist/node.d.cts"
      },
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "bin": {
    "interop-gateway": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "hl7-fhir-translator": "^1.0.1",
    "cda-fhir-translator": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "4.1.10",
    "tsup": "8.5.1",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
