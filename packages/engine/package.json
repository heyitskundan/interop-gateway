{
  "name": "@interop-gateway/engine",
  "version": "1.0.0",
  "description": "Deployable pipeline runtime: wires a protocol source, a format translator, and a destination together from a YAML config.",
  "keywords": [
    "hl7",
    "fhir",
    "pipeline",
    "healthcare",
    "healthtech",
    "interoperability"
  ],
  "license": "Apache-2.0",
  "author": "Kundan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyitskundan/interop-gateway.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/heyitskundan/interop-gateway#readme",
  "bugs": {
    "url": "https://github.com/heyitskundan/interop-gateway/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "interop-gateway-engine": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "Dockerfile"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@interop-gateway/core": "1.0.0",
    "@interop-gateway/format-cda": "1.0.0",
    "@interop-gateway/format-hl7v2": "1.0.0",
    "@interop-gateway/protocol-file": "1.0.0",
    "@interop-gateway/protocol-http": "1.0.0",
    "@interop-gateway/protocol-mllp": "1.0.0",
    "@interop-gateway/validate-us-core": "1.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "4.1.10",
    "tsup": "8.5.1",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
